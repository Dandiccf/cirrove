# Maintainer: Christian Dandachi <dandiccf@users.noreply.github.com>
#
# Three packages from one source: `cirrove` is the daemon and CLI and needs no
# desktop library on the machine; `cirrove-desktop` is the GTK window, tray and
# Files integration; `cirrove-dolphin` is the optional KF6 integration. A
# headless host installs the first alone.
#
# This file is written for a tagged release. Until one exists,
# scripts/build-arch-package.sh builds from the checked-in tree: it archives
# HEAD under the name the source line expects, rewrites pkgver to carry the
# commit, and points makepkg at the archive so nothing is downloaded. The
# checksum stays SKIP until the first tag, when `updpkgsums` fills it in.

pkgbase=cirrove
pkgname=(cirrove cirrove-desktop cirrove-dolphin)
pkgver=0.2.0dev
pkgrel=1
pkgdesc="Cloud drive filesystem that keeps the cloud where it is: OneDrive mounted on demand, without syncing everything"
arch=(x86_64)
url="https://github.com/Dandiccf/cirrove"
license=(Apache-2.0)
# gtk4 and libadwaita are here for the desktop package's build; the daemon
# package's own dependencies are declared on it alone below.
makedepends=(cargo cmake pkgconf gtk4 libadwaita gettext qt6-base kio ki18n)
# Not makepkg's LTO: it puts -flto into the C flags, the bundled TLS library's
# C objects come out as GCC bitcode, and rust-lld cannot read those -- the
# link fails on hundreds of undefined aws_lc symbols. Rust does its own LTO
# from Cargo.toml; the C side is a few objects that gain nothing from it.
options=(!lto)
source=("$pkgbase-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgbase-$pkgver"
  # The repository pins a toolchain in rust-toolchain.toml for contributors; a
  # package builds with the distribution's rust, and a rustup on the builder
  # must not download a second one.
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgbase-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # --workspace: the root's default members exclude the desktop on purpose, so
  # that a plain build needs no GTK. The package builds both halves.
  cargo build --frozen --release --workspace
  cmake -S packaging/dolphin -B target/dolphin -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF
  cmake --build target/dolphin --parallel
}

check() {
  cd "$pkgbase-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # The unit tests, and the tests that read the packaged files and hold them to
  # the shape the install below relies on. Not the mounted-filesystem suites:
  # those need /dev/fuse and a session bus, which a clean build root does not
  # have, and a check that fails for want of a device proves nothing about the
  # package.
  cargo test --frozen --release --workspace --lib
  cargo test --frozen --release -p cirrove-service --test packaging
  cargo test --frozen --release -p cirrove-desktop --test packaging
}

package_cirrove() {
  pkgdesc+=" (service and command line)"
  # fuse3 for fusermount3, which the daemon runs to mount; everything else the
  # binaries need is linked in.
  # xdg-utils is not optional and was, until 2026-09-15, listed as though it
  # were "for the command line". Connecting an account opens the provider's
  # sign-in in a browser, and `xdg-open` is how both the command line and the
  # window do that -- so without it a fresh install cannot connect an account at
  # all, which is the one thing it exists to do. Found on the Arch VM by a
  # person pressing Sign in with Microsoft and being told "could not start the
  # browser: No such file or directory". Fedora and Debian pull it in with a
  # desktop and so never showed it.
  depends=(fuse3 gcc-libs glibc xdg-utils)
  optdepends=(
    'gnome-keyring: keep sign-in grants in a desktop keyring (or any Secret Service)'
    'cirrove-desktop: settings window, tray, and desktop integration'
  )

  cd "$pkgbase-$pkgver"
  install -Dm755 target/release/cirroved "$pkgdir/usr/bin/cirroved"
  install -Dm755 target/release/cirrove "$pkgdir/usr/bin/cirrove"

  # The unit in the tree is the template a developer installs into their own
  # home, so it runs %h/.local/bin/cirroved; a package puts the binary in
  # /usr/bin and the unit must say so. The path is checked after the edit
  # because a sed that matched nothing installs a unit that starts nothing.
  local unit="$pkgdir/usr/lib/systemd/user/cirroved.service"
  sed 's|%h/.local/bin/cirroved|/usr/bin/cirroved|' packaging/systemd/cirroved.service \
    | install -Dm644 /dev/stdin "$unit"
  grep -q '^ExecStart=/usr/bin/cirroved ' "$unit" \
    || { echo "the packaged unit does not run /usr/bin/cirroved" >&2; return 1; }

  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}

package_cirrove-desktop() {
  pkgdesc+=" (settings window, tray and desktop integration)"
  depends=(cirrove gtk4 libadwaita)
  optdepends=(
    'gnome-shell-extension-appindicator: show the tray icon on GNOME'
    'nautilus-python: badges and Keep offline in Files'
    'cirrove-dolphin: badges and Keep offline in Dolphin'
  )

  cd "$pkgbase-$pkgver"
  install -Dm755 target/release/cirrove-desktop "$pkgdir/usr/bin/cirrove-desktop"
  install -Dm755 target/release/cirrove-tray "$pkgdir/usr/bin/cirrove-tray"

  local id=io.github.Dandiccf.Cirrove
  install -Dm644 "packaging/desktop/$id.desktop" -t "$pkgdir/usr/share/applications/"
  # The tray starts with the session, from the system autostart directory. Its
  # Exec= is the bare name, which is right here and only here: /usr/bin is on
  # every generator's PATH, where ~/.local/bin is not.
  install -Dm644 "packaging/desktop/$id.Tray.desktop" -t "$pkgdir/etc/xdg/autostart/"
  install -Dm644 packaging/icons/scalable/apps/*.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 packaging/icons/symbolic/apps/*.svg -t "$pkgdir/usr/share/icons/hicolor/symbolic/apps/"
  install -Dm644 "packaging/metainfo/$id.metainfo.xml" -t "$pkgdir/usr/share/metainfo/"
  # Files loads every extension it finds here when nautilus-python is present;
  # without it the file is inert.
  install -Dm644 packaging/nautilus/cirrove.py -t "$pkgdir/usr/share/nautilus-python/extensions/"
  # Translations. The window binds its catalogue relative to its own binary, so
  # /usr/bin/cirrove-desktop finds /usr/share/locale without being told.
  for po in po/*.po; do
    local lang
    lang=$(basename "$po" .po)
    install -d "$pkgdir/usr/share/locale/$lang/LC_MESSAGES"
    msgfmt --check -o "$pkgdir/usr/share/locale/$lang/LC_MESSAGES/cirrove.mo" "$po"
  done

  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}

package_cirrove-dolphin() {
  pkgdesc+=" (Dolphin badges and offline actions)"
  # The desktop package owns the shared icon theme entries and gettext domain
  # used by both file-manager integrations.
  depends=(cirrove-desktop kio ki18n qt6-base)

  cd "$pkgbase-$pkgver"
  DESTDIR="$pkgdir" cmake --install target/dolphin --prefix /usr
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
