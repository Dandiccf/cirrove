 "small_kernel_fixture": {
  "test": "filesystem::capacity::real_directory_prefix_precedes_completion_and_close_cancels_building",
  "files_in_directory": 2000,
  "method": "Only the first 128 inode mappings are cached; a separate SQLite writer holds BEGIN IMMEDIATE so later inode batches cannot proceed until released.",
  "ci_first_entry_ms": [
   4.642224,
   4.448108
  ],
  "local_release_first_entry_ms": [
   0.940505,
   0.825193
  ],
  "bound_ms": 500,
  "behaviour": [
   "A rename committed after OPENDIR does not change the already-opened listing; a fresh listing observes it.",
   "Closing during construction cancels the producer once its blocked batch returns.",
   "Both cases retire every view except the root and release all snapshot storage."
  ]
 },
